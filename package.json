  "//=============================================================================": "",
  "name": "comp-os-nexus",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "COMP-OS: The World Standard for Competitive Gaming & Anti-Cheat Ecosystems.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.2.0"
  },
  "packageManager": "npm@10.5.0",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:ci": "npm run security:check && npm run lint && vite build",
    "preview": "vite preview",
    "analyze": "vite build --mode production && npx serve dist",
    "lint": "eslint . --ext .js,.jsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext .js,.jsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css,json}\"",
    "security:check": "npm audit --production --audit-level=moderate",
    "security:fix": "npm audit fix --production",
    "deps:check": "npm outdated",
    "deps:audit": "npm audit --production && npx license-checker --summary",
    "clean": "rm -rf dist node_modules/.vite",
    "nuke": "rm -rf dist node_modules package-lock.json && npm install",
    "test:integrity": "npm run build:ci",
    "prepare": "husky install",
    "preinstall": "npx only-allow npm"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "1.0.5",
