    "clsx": "2.1.0",
    "cmdk": "0.2.1",
    "date-fns": "3.6.0",
    "framer-motion": "11.0.25",
    "howler": "2.2.4",
    "lucide-react": "0.368.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-error-boundary": "4.0.13",
    "react-helmet-async": "2.0.5",
    "react-hook-form": "^7.72.1",
    "react-hot-toast": "2.4.1",
    "react-router-dom": "6.26.2",
    "recharts": "2.12.0",
    "tailwind-merge": "2.2.2",
    "three": "0.163.0",
